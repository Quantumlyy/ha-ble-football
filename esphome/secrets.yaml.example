# Copy to secrets.yaml and fill in. secrets.yaml is git-ignored.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# 32 random bytes, base64. Generate with: openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_BASE64_KEY="
ota_password: "choose-an-ota-password"

# Any random string. Must be the same on all four nodes, and kept private:
# anyone who knows it could turn a known MAC address into a reported id.
footfall_salt: "replace-with-a-long-random-string"
